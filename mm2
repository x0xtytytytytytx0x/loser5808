CombatTab:CreateKeybind({
	name = "Shoot murderer",
	value = Enum.KeyCode.Q,
	callback = function()
		local tool = getEquippedTool(LocalPlayer)
		if not tool or string.lower(tool.Name) ~= "gun" then
			equipToolNamed("Gun")
			task.wait(0.05)
			tool = getEquippedTool(LocalPlayer)
		end
		if not tool or string.lower(tool.Name) ~= "gun" then
			notify("Combat", "Equip the Gun first.", 2)
			return
		end
		local m = findMurderer()
		local thrp = getHRP(m)
		if not thrp then
			notify("Combat", "No murderer found.", 2)
			return
		end
		if fireGunAt(thrp) then
			notify("Combat", "Shot at " .. (m and m.DisplayName or "?"), 2)
		else
			notify("Combat", "Shoot remote missing.", 2)
		end
	end,
})

CombatTab:CreateKeybind({
	name = "Throw knife at sheriff",
	value = Enum.KeyCode.E,
	callback = function()
		local tool = getEquippedTool(LocalPlayer)
		if not tool or string.lower(tool.Name) ~= "knife" then
			equipToolNamed("Knife")
			task.wait(0.05)
			tool = getEquippedTool(LocalPlayer)
		end
		if not tool or string.lower(tool.Name) ~= "knife" then
			notify("Combat", "Equip the Knife first.", 2)
			return
		end
		local s = findSheriff()
		local thrp = getHRP(s)
		if not thrp then
			local best, bestD = nil, math.huge
			local my = getHRP(LocalPlayer)
			if my then
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer and playerIsAlive(plr) then
						local h = getHRP(plr)
						if h then
							local d = (h.Position - my.Position).Magnitude
							if d < bestD then bestD, best = d, h end
						end
					end
				end
			end
			thrp = best
		end
		if not thrp then
			notify("Combat", "No target.", 2)
			return
		end
		if fireKnifeAt(thrp) then
			notify("Combat", "Knife thrown.", 2)
		else
			notify("Combat", "KnifeThrown missing (equip knife).", 2)
		end
	end,
})


