local FlyCoinOn = false
local flyCoinToken = 0

local function nearestCoin()
	local hrp = getHRP(LocalPlayer)
	if not hrp then return nil end
	local best, bestDist = nil, math.huge
	for _, coin in ipairs(findMainCoins()) do
		local d = (coin.Position - hrp.Position).Magnitude
		if d < bestDist then
			bestDist = d
			best = coin
		end
	end
	return best
end

BanTab:CreateToggle({
	name = "Slow fly to coins",
	value = false,
	callback = function(state)
		FlyCoinOn = state
		flyCoinToken += 1
		local myToken = flyCoinToken
		if not state then
			notify("Bannable", "Coin fly off.", 2)
			return
		end
		notify("Bannable", "⚠ Coin fly ON — ban risk.", 4)
		task.spawn(function()
			while FlyCoinOn and myToken == flyCoinToken do
				local hrp = getHRP(LocalPlayer)
				local coin = nearestCoin()
				if hrp and coin then
					local target = coin.Position + Vector3.new(0, 2, 0)
					local dir = target - hrp.Position
					local dist = dir.Magnitude
					if dist > 2 then
						hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * math.min(dist, 6))
					end
				end
				task.wait(0.08)
			end
		end)
	end,
})

local TpAllCoinsOn = false
local tpAllToken = 0

BanTab:CreateToggle({
	name = "TP all coins (until gone)",
	value = false,
	callback = function(state)
		TpAllCoinsOn = state
		tpAllToken += 1
		local myToken = tpAllToken
		if not state then
			notify("Bannable", "TP-all-coins off.", 2)
			return
		end
		notify("Bannable", "⚠ TP all coins ON — high ban risk.", 4)
		task.spawn(function()
			local lastTarget = nil
			while TpAllCoinsOn and myToken == tpAllToken do
				local coins = findMainCoins() -- only Transparency ~ 0
				if #coins == 0 then
					notify("Bannable", "No visible coins left.", 2)
					TpAllCoinsOn = false
					break
				end

				local hrp = getHRP(LocalPlayer)
				if not hrp then
					task.wait(0.2)
					continue -- Luau: use else path if needed
				end

				-- pick nearest that isn't the one we just sat on (if still listed)
				local best, bestDist = nil, math.huge
				for _, coin in ipairs(coins) do
					if coin ~= lastTarget and coin.Parent then
						local d = (coin.Position - hrp.Position).Magnitude
						if d < bestDist then
							bestDist = d
							best = coin
						end
					end
				end
				-- if only lastTarget left, use it
				if not best then
					best = coins[1]
				end

				if best and best.Parent and (best.Transparency or 0) <= 0.05 then
					hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
					lastTarget = best
					-- wait until this coin disappears / goes transparent, or timeout
					local t0 = os.clock()
					while TpAllCoinsOn and myToken == tpAllToken do
						if not best.Parent then break end
						if (best.Transparency or 0) > 0.05 then break end
						if os.clock() - t0 > 2.5 then break end -- stuck → next
						task.wait(0.1)
					end
				end
				task.wait(0.08)
			end
		end)
	end,
})

