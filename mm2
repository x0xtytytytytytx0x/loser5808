local function getSearchText()
	if not searchBox then return "" end
	if searchBox.Get then
		local ok, t = pcall(function() return searchBox:Get() end)
		if ok and t ~= nil then return tostring(t) end
	end
	return ""
end

local function findPlayer(q)
	q = string.lower(tostring(q or "")):gsub("%s+", "")
	if q == "" then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(plr.Name), q, 1, true)
			or string.find(string.lower(plr.DisplayName), q, 1, true) then
			return plr
		end
	end
	return nil
end

local function attrStr(plr, name)
	local v = plr:GetAttribute(name)
	if v == nil then return "—" end
	return tostring(v)
end

local st = {
	who = InfoTab:CreateStat({ name = "Player", value = "—" }),
	alive = InfoTab:CreateStat({ name = "Alive", value = "—" }),
	elite = InfoTab:CreateStat({ name = "Elite", value = "—" }),
	gun = InfoTab:CreateStat({ name = "EquipedGun", value = "—" }),
	knife = InfoTab:CreateStat({ name = "EquiptedKnife", value = "—" }),
	perk = InfoTab:CreateStat({ name = "EquippedPerk", value = "—" }),
	level = InfoTab:CreateStat({ name = "Level", value = "—" }),
	prestige = InfoTab:CreateStat({ name = "Prestige", value = "—" }),
	xp = InfoTab:CreateStat({ name = "XP", value = "—" }),
	role = InfoTab:CreateStat({ name = "Role guess", value = "—" }),
}

local function setStat(ctrl, text)
	if not ctrl then return end
	text = tostring(text or "—")
	if ctrl.Set then pcall(function() ctrl:Set(text) end)
	elseif ctrl.set then pcall(function() ctrl:set(text) end)
	else pcall(function() if ctrl.Text ~= nil then ctrl.Text = text end end)
	end
end

local function loadPlayerInfo(plr)
	setStat(st.who, plr.DisplayName .. " (@" .. plr.Name .. ")")
	setStat(st.alive, tostring(plr:GetAttribute("Alive")))
	setStat(st.elite, attrStr(plr, "Elite"))
	setStat(st.gun, attrStr(plr, "EquipedGun"))
	setStat(st.knife, attrStr(plr, "EquiptedKnife"))
	setStat(st.perk, attrStr(plr, "EquippedPerk"))
	setStat(st.level, attrStr(plr, "level") ~= "—" and attrStr(plr, "level") or attrStr(plr, "Level"))
	setStat(st.prestige, attrStr(plr, "Prestige"))
	setStat(st.xp, attrStr(plr, "XP"))
	local role = "Innocent"
	if playerHasKnife(plr) then role = "Murderer"
	elseif playerHasGun(plr) then role = "Sheriff"
	end
	setStat(st.role, role)
end

