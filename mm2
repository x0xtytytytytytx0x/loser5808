						local thrp = getHRP(m)
						if thrp then
							myHRP.CFrame = CFrame.new(thrp.Position + Vector3.new(0, 0, 4))
							task.wait(0.05)
							equipToolNamed("Gun")
							fireGunAt(thrp)
						end
					elseif playerHasKnife(LocalPlayer) then
						local s = findSheriff()
						local thrp = getHRP(s)
						if thrp then
							myHRP.CFrame = CFrame.new(thrp.Position + Vector3.new(0, 0, 3))
							task.wait(0.05)
							equipToolNamed("Knife")
							fireKnifeAt(thrp)
						end
					end
				end
				task.wait(0.2)
			end
		end)
	end,
})

