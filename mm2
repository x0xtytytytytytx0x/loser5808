local function refreshGunDrops()
	if not GunDropOn then return end
	local seen = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == "GunDrop" then
			local adornee = inst
			if not inst:IsA("Model") and not inst:IsA("BasePart") then
				if inst.Parent and (inst.Parent:IsA("Model") or inst.Parent:IsA("BasePart")) then
					adornee = inst.Parent
				end
			end
			local key = "GunDrop_" .. tostring(adornee:GetDebugId())
			seen[key] = true
			makeHighlight(key, adornee, COLOR_GUNDROP, COLOR_GUNDROP, 0.4, 0)
		end
	end
	local f = getHighlightFolder()
	if f then
		for _, c in ipairs(f:GetChildren()) do
			if c.Name:sub(1, 8) == "GunDrop_" and not seen[c.Name] then
				c:Destroy()
			end
		end
	end
end

