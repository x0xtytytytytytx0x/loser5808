local HIGHLIGHT_FOLDER = "R8_ESP_Highlights"

local function getHighlightFolder()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local f = pg:FindFirstChild(HIGHLIGHT_FOLDER)
	if not f then
		f = Instance.new("Folder")
		f.Name = HIGHLIGHT_FOLDER
		f.Parent = pg
	end
	return f
end

local function clearHighlights(prefix)
	local f = getHighlightFolder()
	if not f then return end
	for _, c in ipairs(f:GetChildren()) do
		if not prefix or c.Name:sub(1, #prefix) == prefix then
			c:Destroy()
		end
	end
end

local function makeHighlight(name, adornee, fill, outline, fillT, outlineT)
	local folder = getHighlightFolder()
	if not folder or not adornee then return nil end
	local h = folder:FindFirstChild(name)
	if not h then
		h = Instance.new("Highlight")
		h.Name = name
		h.Parent = folder
	end
	h.Adornee = adornee
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillColor = fill
	h.OutlineColor = outline
	h.FillTransparency = fillT or 0.55
	h.OutlineTransparency = outlineT or 0
	return h
end

local function playerIsAlive(plr)
	if not plr then return false end
	if plr:GetAttribute("Alive") == false then return false end
	return true
end

local function hasToolNamed(container, name)
	if not container then return false end
	local lower = string.lower(name)
	for _, t in ipairs(container:GetChildren()) do
		if t:IsA("Tool") and string.lower(t.Name) == lower then
			return true
		end
	end
	return false
end

local function playerHasKnife(plr)
	local bp = plr:FindFirstChildOfClass("Backpack")
	local char = plr.Character
	return hasToolNamed(bp, "Knife") or hasToolNamed(char, "Knife")
end

local function playerHasGun(plr)
	local bp = plr:FindFirstChildOfClass("Backpack")
	local char = plr.Character
	return hasToolNamed(bp, "Gun") or hasToolNamed(char, "Gun")
end

local function getEquippedTool(plr)
	local char = plr and plr.Character
	return char and char:FindFirstChildOfClass("Tool")
end

local function localHasKnife()
	return playerHasKnife(LocalPlayer)
end

local function findMurderer()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and playerIsAlive(plr) and playerHasKnife(plr) then
			return plr
		end
	end
	return nil
end

local function findSheriff()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and playerIsAlive(plr) and playerHasGun(plr) then
			return plr
		end
	end
	return nil
end

local function getHRP(plr)
	local char = plr and plr.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getNil(name, class)
	if typeof(getnilinstances) ~= "function" then return nil end
	for _, v in next, getnilinstances() do
		if v.ClassName == class and v.Name == name then
			return v
		end
	end
	return nil
end

-- Resolve Shoot remote the same way normal shots do
local function getShootRemote()
	local r = LocalPlayer:FindFirstChild("Shoot")
	if r and r:IsA("RemoteEvent") then return r end
	r = getNil("Shoot", "RemoteEvent")
	if r then return r end
	return nil
end

--[[
	Normal shot args:
	  [1] = origin CFrame (your HRP / gun look)
	  [2] = target CFrame (usually position-only identity rotation)
]]
local function fireGunAt(targetHRP)
	local myHRP = getHRP(LocalPlayer)
	if not myHRP or not targetHRP then return false end

	local remote = getShootRemote()
	if not remote then return false end

	local origin = myHRP.CFrame
	local target = CFrame.new(targetHRP.Position) -- match captured shots

	local ok = pcall(function()
		remote:FireServer(origin, target)
	end)
	return ok
end

local function fireKnifeAt(targetHRP)
	local myHRP = getHRP(LocalPlayer)
	if not myHRP or not targetHRP then return false end
	local knife = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Knife")
	local ev = knife and knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown")
	if not ev then return false end
	local ok = pcall(function()
		ev:FireServer(myHRP.CFrame, CFrame.new(targetHRP.Position))
	end)
	return ok
end

local function equipToolNamed(name)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	if not hum or not bp then return end
	local tool = bp:FindFirstChild(name)
	if tool then pcall(function() hum:EquipTool(tool) end) end
end

