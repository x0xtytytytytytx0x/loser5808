local COLOR_MURDER = Color3.fromRGB(255, 40, 40)
local COLOR_SHERIFF = Color3.fromRGB(50, 120, 255)
local COLOR_WHITE = Color3.fromRGB(255, 255, 255)
local COLOR_GUNDROP = Color3.fromRGB(255, 220, 40)
local COLOR_COIN = Color3.fromRGB(255, 255, 255)

local RoleEspOn = false
local roleEspToken = 0
local lastMurdererName, lastSheriffName = nil, nil

local function refreshRoleEsp()
	if not RoleEspOn then return end
	local murderer, sheriff = nil, nil
	local showWhite = localHasKnife()

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then
			-- skip
		elseif not playerIsAlive(plr) then
			local f = getHighlightFolder()
			if f then
				local h = f:FindFirstChild("Role_" .. plr.UserId)
				if h then h:Destroy() end
			end
		else
			local char = plr.Character
			if not char then
				local f = getHighlightFolder()
				if f then
					local h = f:FindFirstChild("Role_" .. plr.UserId)
					if h then h:Destroy() end
				end
			else
				local isKnife = playerHasKnife(plr)
				local isGun = playerHasGun(plr)
				if isKnife then
					murderer = plr
					makeHighlight("Role_" .. plr.UserId, char, COLOR_MURDER, COLOR_MURDER, 0.45, 0)
				elseif isGun then
					sheriff = plr
					makeHighlight("Role_" .. plr.UserId, char, COLOR_SHERIFF, COLOR_SHERIFF, 0.45, 0)
				elseif showWhite then
					makeHighlight("Role_" .. plr.UserId, char, COLOR_WHITE, COLOR_WHITE, 0.85, 0)
				else
					local f = getHighlightFolder()
					if f then
						local h = f:FindFirstChild("Role_" .. plr.UserId)
						if h then h:Destroy() end
					end
				end
			end
		end
	end

	local mName = murderer and murderer.DisplayName or nil
	local sName = sheriff and sheriff.DisplayName or nil
	if mName and mName ~= lastMurdererName then
		notify("Murderer", mName .. " has the knife.", 4)
	end
	if sName and sName ~= lastSheriffName then
		notify("Sheriff", sName .. " has the gun.", 4)
	end
	lastMurdererName, lastSheriffName = mName, sName
end

