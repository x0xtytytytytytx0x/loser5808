		else
			clearClones()
		end

		if state then
			task.spawn(function()
				local hue = 0
				while PoolState.rainbow do
					hue = (hue + 0.008) % 1
					local color = Color3.fromHSV(hue, 1, 1)
					pcall(applyRainbowColor, color)
					task.wait(0.025)
				end
			end)
		end
	end,
})

