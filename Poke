-- Sleeping Beauty Counter (put this in your Home / main tab)
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function getSleepingBeautyCount()
	local count = 0
	local backpack = player:FindFirstChild("Backpack")
	local char = player.Character

	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item.Name == "Sleeping Beauty" then
				count += 1
			end
		end
	end

	-- also count if it's currently equipped
	if char then
		local held = char:FindFirstChildOfClass("Tool")
		if held and held.Name == "Sleeping Beauty" then
			count += 1
		end
	end

	return count
end

local sleepingStat = tab:CreateStat({
	name = "Sleeping Beauty",
	value = getSleepingBeautyCount()
})

-- live update
task.spawn(function()
	while true do
		sleepingStat:Set(getSleepingBeautyCount())  -- most UIs use :Set()
		-- If your UI library uses a different method, try:
		-- sleepingStat.Value = getSleepingBeautyCount()
		-- or sleepingStat:Update(getSleepingBeautyCount())
		task.wait(0.25)
	end
end)


