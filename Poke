Games:CreateButton({
	name = "Start Music Room",
	buttonText = "Start / Stop",
	callback = function()
		if MusicState.playing then
			MusicState.playing = false
			MusicState.token += 1
			releaseAllHolds()
			MusicProgress:Set(0)
			window:Notify({ title = "Music Room", text = "Stopped.", icon = 127357392034684, duration = 2 })
			return
		end

		local highway = getHighway()
		if not highway then
			window:Notify({
				title = "Music Room",
				text = "MusicRoomGui not open.",
				icon = 127357392034684,
				duration = 3,
			})
			return
		end

		MusicState.playing = true
		MusicState.token += 1
		local myToken = MusicState.token
		recentTaps = {}
		releaseAllHolds()

		local guitar = isGuitarMode(highway)
		window:Notify({
			title = "Music Room",
			text = (guitar and "Guitar (F/J)" or "Drums (D/F/J/K)")
				.. (MusicState.fakeIt and " · Fake it ON" or ""),
			icon = 127357392034684,
			duration = 2,
		})

		task.spawn(function()
			local BASE_PAD = 18
			-- release hold slightly before tail center fully passes (helps stacked notes)
			local RELEASE_EARLY = 6

			while MusicState.playing and MusicState.token == myToken do
				highway = getHighway()
				if not highway then
					task.wait(0.1)
				else
					guitar = isGuitarMode(highway)
					local hitLine = highway:FindFirstChild("HitLine")
					local noteLayer = highway:FindFirstChild("NoteLayer")
					local hitY = hitLine and (hitLine.AbsolutePosition.Y + hitLine.AbsoluteSize.Y * 0.5)

					if noteLayer and hitY then
						local pad = BASE_PAD
						if MusicState.fakeIt then
							pad = BASE_PAD + math.random(-6, 10)
						end

						for _, note in ipairs(noteLayer:GetChildren()) do
							if note:IsA("GuiObject") and note.Visible then
								local isHold = note.Name == "NoteHold" or note:FindFirstChild("Head") ~= nil

								if isHold then
									local head = note:FindFirstChild("Head")
									local tail = note:FindFirstChild("Tail")
									local col = noteColor(head) or noteColor(note) or noteColor(tail)
									local key = keyForNoteColor(col, guitar)

									if key then
										local headY = head and (head.AbsolutePosition.Y + head.AbsoluteSize.Y * 0.5)
										local tailY = tail and (tail.AbsolutePosition.Y + tail.AbsoluteSize.Y * 0.5)
										local headNear = headY and math.abs(headY - hitY) <= pad

										-- release as soon as Tail reaches / passes hit line (not when destroyed)
										local tailPast = false
										if tailY then
											-- notes move toward hit line; once tail center is at line, end hold
											tailPast = math.abs(tailY - hitY) <= RELEASE_EARLY
												or (hitY and tailY > hitY + RELEASE_EARLY)
										end

										if activeHolds[note] then
											if not note.Parent or not note.Visible or tailPast or (tail and not tail.Parent) then
												releaseHold(note)
											end
										elseif headNear and not activeHolds[note] then
											if MusicState.fakeIt and math.random() < 0.06 then
												-- soft miss hold start
											else
												local delay = MusicState.fakeIt and (math.random() * 0.03) or 0
												local n, k = note, key
												task.delay(delay, function()
													if not MusicState.playing or MusicState.token ~= myToken then return end
													if n.Parent and not activeHolds[n] then
														startHold(n, k)
													end
												end)
											end
										end
									end
								else
									-- NoteTap
									local noteY = note.AbsolutePosition.Y + note.AbsoluteSize.Y * 0.5
									if math.abs(noteY - hitY) <= pad then
										local id = tostring(note:GetDebugId())
										local now = os.clock()
										if not recentTaps[id] or (now - recentTaps[id]) > 0.12 then
											local key = keyForNoteColor(noteColor(note), guitar)
											if key then
												if MusicState.fakeIt and math.random() < 0.05 then
													recentTaps[id] = now
												else
													local delay = MusicState.fakeIt and (math.random() * 0.04) or 0
													task.delay(delay, function()
														if MusicState.playing and MusicState.token == myToken then
															tapKey(key)
														end
													end)
													recentTaps[id] = now
												end
											end
										end
									end
								end
							end
						end

						-- orphan cleanup
						for n in pairs(activeHolds) do
							if not n.Parent or not n.Visible then
								releaseHold(n)
							end
						end
					end

					local gui = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("MusicRoomGui")
					local timeLabel = gui
						and gui:FindFirstChild("Band")
						and gui.Band:FindFirstChild("Panel")
						and gui.Band.Panel:FindFirstChild("TimeLabel")
					if timeLabel and timeLabel:IsA("TextLabel") then
						local cur, tot = parseTimeLabel(timeLabel.Text)
						if cur and tot and tot > 0 then
							MusicProgress:Set(math.clamp(math.floor(cur / tot * 100), 0, 100))
						end
					end
				end
				task.wait(0.01)
			end

			releaseAllHolds()
		end)
	end,
})

