local COLOR_TOL = 12

local function colorClose(c, r, g, b)
	if not c then return false end
	return math.abs(c.R * 255 - r) <= COLOR_TOL
		and math.abs(c.G * 255 - g) <= COLOR_TOL
		and math.abs(c.B * 255 - b) <= COLOR_TOL
end

local function getHud()
	local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
	local gui = pg and pg:FindFirstChild("MusicRoomGui")
	return gui and gui:FindFirstChild("Hud")
