				:WaitForChild("Bottles")
				:WaitForChild("Sleeping Beauty")

			local ITEM_NAME = "???"  -- change this if the tool name is different

			local function countItem(char, backpack)
				local count = 0
				if backpack then
					for _, item in ipairs(backpack:GetChildren()) do
						if item.Name == ITEM_NAME then count += 1 end
					end
				end
				local held = char and char:FindFirstChildOfClass("Tool")
