local function isGuitarMode(highway)
	local receptorR = highway:FindFirstChild("ReceptorR")
	local label = receptorR and receptorR:FindFirstChild("KeyLabel")
	if label and label:IsA("TextLabel") then
		local t = string.upper(string.gsub(label.Text or "", "%s+", ""))
		if t == "J" then return true end
		if t == "D" or t == "K" then return false end
	end
	return highway:FindFirstChild("ReceptorC1") == nil
end

local function noteColor(inst)
	if not inst then return nil end
	if inst:IsA("ImageLabel") then return inst.ImageColor3 end
	if inst:IsA("GuiObject") then return inst.BackgroundColor3 end
	return nil
end

local function keyForNoteColor(color, guitar)
	if not color then return nil end
	if guitar then
		if colorClose(color, 85, 238, 254) then return Enum.KeyCode.F end
		if colorClose(color, 243, 17, 186) then return Enum.KeyCode.J end
	else
		if colorClose(color, 243, 17, 186) then return Enum.KeyCode.F end
		if colorClose(color, 251, 191, 36) then return Enum.KeyCode.J end
		if colorClose(color, 85, 238, 254) then return Enum.KeyCode.D end
		if colorClose(color, 139, 92, 246) then return Enum.KeyCode.K end
	end
	return nil
end

local function parseTimeLabel(text)
	if type(text) ~= "string" then return nil, nil end
	local a, b, c, d = text:match("(%d+):(%d+)%s*/%s*(%d+):(%d+)")
	if not a then return nil, nil end
	return tonumber(a) * 60 + tonumber(b), tonumber(c) * 60 + tonumber(d)
end

local vim = game:GetService("VirtualInputManager")
local function keyDown(code)
	if code then vim:SendKeyEvent(true, code, false, game) end
end
local function keyUp(code)
	if code then vim:SendKeyEvent(false, code, false, game) end
end

-- activeHolds[note] = KeyCode
-- heldKeys[KeyCode] = note  (so we can free a key for the next note)
local activeHolds = {}
local heldKeys = {}
local recentTaps = {}

local function releaseHold(note)
	local code = activeHolds[note]
	if not code then return end
	keyUp(code)
	activeHolds[note] = nil
	if heldKeys[code] == note then
		heldKeys[code] = nil
	end
end

local function releaseAllHolds()
	for note in pairs(activeHolds) do
		releaseHold(note)
	end
	activeHolds = {}
	heldKeys = {}
end

-- free this key if something else is holding it (next note right behind tail)
local function ensureKeyFree(code)
	local owner = heldKeys[code]
	if owner then
		releaseHold(owner)
	end
end

local function startHold(note, code)
	ensureKeyFree(code)
	keyDown(code)
	activeHolds[note] = code
	heldKeys[code] = note
end

local function tapKey(code)
	if not code then return end
	ensureKeyFree(code) -- don't miss a tap stuck behind a hold
	keyDown(code)
	task.delay(0.035, function()
		-- only release if a hold didn't take this key over
		if not heldKeys[code] then
			keyUp(code)
		end
	end)
end

