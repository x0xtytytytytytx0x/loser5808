local function getGlassToolName()
	if SelectedGlass == "WineGlass" then
		return "WhineGlass" -- game spelling
	end
	return SelectedGlass
end

local function findClickDetector(root, targetName)
	if not root then return nil end

	-- direct child
	local model = root:FindFirstChild(targetName)
	if model then
		local cd = model:FindFirstChildOfClass("ClickDetector")
		if cd then return cd end
	end

	-- deep search
	for _, desc in ipairs(root:GetDescendants()) do
		if desc.Name == targetName then
			local cd = desc:FindFirstChildOfClass("ClickDetector")
			if cd then return cd end
			if desc.Parent then
				cd = desc.Parent:FindFirstChildOfClass("ClickDetector")
				if cd then return cd end
			end
		end
	end
	return nil
end

local function getSelectedGlassClick()
	local toolName = getGlassToolName()
	local cd = findClickDetector(DrinkArtist, toolName)

	-- fallbacks for the ones that sometimes sit under numbered children
	if not cd then
		if SelectedGlass == "Cup" then
			cd = findClickDetector(DrinkArtist:FindFirstChild("Cup"), "Cup")
		elseif SelectedGlass == "ShotGlass" then
			local obj = DrinkArtist:GetChildren()[40]
			cd = obj and findClickDetector(obj, "ShotGlass")
		elseif SelectedGlass == "WineGlass" then
			local obj = DrinkArtist:GetChildren()[34]
			cd = obj and findClickDetector(obj, "WhineGlass")
		elseif SelectedGlass == "Mug" then
			local obj = DrinkArtist:GetChildren()[35]
			cd = obj and findClickDetector(obj, "Mug")
		elseif SelectedGlass == "Margarita" then
			local obj = DrinkArtist:GetChildren()[32]
			cd = obj and findClickDetector(obj, "Margarita")
		end
	end

	if cd then
		pcall(function() fireclickdetector(cd) end)
		return true
	end
	return false
end

local function equipGlass()
	local toolName = getGlassToolName()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChild("Backpack")
	if not (char and humanoid and backpack) then return false end

	if char:FindFirstChild(toolName) then return true end

	local tool = backpack:FindFirstChild(toolName)
	if tool then
		humanoid:EquipTool(tool)
		task.wait(0.12)
		return char:FindFirstChild(toolName) ~= nil
	end
	return false
end

local function ensureGlass()
	if equipGlass() then return true end

	-- not in backpack → grab it
	if getSelectedGlassClick() then
		task.wait(0.3) -- wait for server to give the tool
		return equipGlass()
	end
	return false
end

local function mix(...)
	for _, bottleName in ipairs({...}) do
		local bottle = Bottles:FindFirstChild(bottleName)
		if bottle then
			ToolAction:FireServer("Mix", bottle, 0)
		else
			warn("Bottle not found:", bottleName)
		end
	end
end

local function addEnabledCosmetics()
	for _, name in ipairs(SelectedCosmetics) do
		local cos = Cosmetics:FindFirstChild(name)
		if cos then
			ToolAction:FireServer("AddCosmetic", cos)
		end
	end
end

local function makeDrink(...)
	if not ensureGlass() then
		window:Notify({ title = "Drinks", text = "Could not grab/equip glass (" .. tostring(SelectedGlass) .. ")", icon = 127357392034684, duration = 3 })
		return false
	end
	task.wait(0.08)
	mix(...)
	task.wait(0.06)
	addEnabledCosmetics()
	return true
end
