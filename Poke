tab:CreateToggle({
	name = "Auto Place Only",
	value = false,
	callback = function(state)
		getgenv().AutoPlaceOnly = state
		if not state then return end

		task.spawn(function()
			local Players = game:GetService("Players")
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local player = Players.LocalPlayer
			local PlaceTool = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PlaceTool")

			local goodRotation = CFrame.new(
				0, 0, 0,
				-0.9999921321868896, -0.002560368739068508, 0.003036483423784375,
				0, 0.7644979357719421, 0.6446262001991272,
				-0.003971865866333246, 0.6446211338043213, -0.7644919157028198
			)

			local MAX_DISTANCE = 20
			local PLACEMENTS_PER_TABLE = 12
			local index, placeCount = 1, 0
			local nearbyTables = {}

			local function updateNearbyTables()
				nearbyTables = {}
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not root then return end
				local map = workspace:FindFirstChild("Map")
				if not map then return end
				local seen = {}
				for _, obj in ipairs(map:GetDescendants()) do
					if obj.Name == "CanPlaceDrink" then
						local part = obj:IsA("BasePart") and obj or obj.Parent
						if part and part:IsA("BasePart") and not seen[part] then
							if (part.Position - root.Position).Magnitude <= MAX_DISTANCE then
								seen[part] = true
								table.insert(nearbyTables, part)
							end
						end
					end
				end
			end

			task.spawn(function()
				while getgenv().AutoPlaceOnly do
					updateNearbyTables()
					task.wait(1)
				end
			end)

			local function getRandomPositionOnPart(part)
				local size, cf = part.Size, part.CFrame
				local offsetX = (math.random() - 0.5) * (size.X * 0.75)
				local offsetZ = (math.random() - 0.5) * (size.Z * 0.75)
				local offsetY = size.Y / 2 + 0.08
				return (cf * CFrame.new(offsetX, offsetY, offsetZ)).Position
			end

			while getgenv().AutoPlaceOnly do
				local char = player.Character
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")
				local backpack = player:FindFirstChild("Backpack")

				if char and humanoid then
					local tool = char:FindFirstChild("Sleeping Beauty")
					if not tool and backpack then
						local sleeping = backpack:FindFirstChild("Sleeping Beauty")
						if sleeping then
							humanoid:EquipTool(sleeping)
							task.wait(0.06)
						end
					end
					tool = char:FindFirstChild("Sleeping Beauty")

					if tool and #nearbyTables > 0 then
						if index > #nearbyTables then index = 1 end
						local target = nearbyTables[index]
						if target and target.Parent then
							local placeCF = CFrame.new(getRandomPositionOnPart(target)) * goodRotation
							PlaceTool:FireServer(placeCF)
							placeCount += 1
						end
						if placeCount >= PLACEMENTS_PER_TABLE then
							placeCount = 0
							index += 1
						end
					end
				end
				task.wait()
			end
		end)
	end,
})


