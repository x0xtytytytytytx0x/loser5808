	["Q"]=Enum.KeyCode.Q,["W"]=Enum.KeyCode.W,["E"]=Enum.KeyCode.E,["R"]=Enum.KeyCode.R,
	["T"]=Enum.KeyCode.T,["Y"]=Enum.KeyCode.Y,["U"]=Enum.KeyCode.U,["I"]=Enum.KeyCode.I,
	["O"]=Enum.KeyCode.O,["P"]=Enum.KeyCode.P,
	["A"]=Enum.KeyCode.A,["S"]=Enum.KeyCode.S,["D"]=Enum.KeyCode.D,["F"]=Enum.KeyCode.F,
	["G"]=Enum.KeyCode.G,["H"]=Enum.KeyCode.H,["J"]=Enum.KeyCode.J,["K"]=Enum.KeyCode.K,
	["L"]=Enum.KeyCode.L,["Z"]=Enum.KeyCode.Z,["X"]=Enum.KeyCode.X,["C"]=Enum.KeyCode.C,
	["V"]=Enum.KeyCode.V,["B"]=Enum.KeyCode.B,["N"]=Enum.KeyCode.N,["M"]=Enum.KeyCode.M,
}

local SHIFT_CHARS = {
	["!"]=true,["@"]=true,["#"]=true,["$"]=true,["%"]=true,["^"]=true,
	["&"]=true,["*"]=true,["("]=true,[")"]=true,
	["Q"]=true,["W"]=true,["E"]=true,["R"]=true,["T"]=true,["Y"]=true,
	["U"]=true,["I"]=true,["O"]=true,["P"]=true,
	["A"]=true,["S"]=true,["D"]=true,["F"]=true,["G"]=true,["H"]=true,
	["J"]=true,["K"]=true,["L"]=true,["Z"]=true,["X"]=true,["C"]=true,
	["V"]=true,["B"]=true,["N"]=true,["M"]=true,
}

local vim = game:GetService("VirtualInputManager")
local function keyDown(code) vim:SendKeyEvent(true, code, false, game) end
local function keyUp(code) vim:SendKeyEvent(false, code, false, game) end

local function extractChars(token)
	-- strip [ ] if present; keep only playable keys
	token = token:gsub("^%[", ""):gsub("%]$", "")
	local chars = {}
	for i = 1, #token do
		local ch = token:sub(i, i)
		if CHAR_TO_KEY[ch] then
			table.insert(chars, ch)
		end
	end
	return chars
end

local function pressChars(chars)
	if not chars or #chars == 0 then return end
	local needShift = false
	for _, ch in ipairs(chars) do
		if SHIFT_CHARS[ch] then needShift = true break end
	end
	if needShift then keyDown(Enum.KeyCode.LeftShift) end
	for _, ch in ipairs(chars) do
		local code = CHAR_TO_KEY[ch]
		if code then keyDown(code) end
	end
	-- hold scales slightly with chord size
	task.wait(0.045 + math.min(#chars, 6) * 0.008)
	for _, ch in ipairs(chars) do
		local code = CHAR_TO_KEY[ch]
		if code then keyUp(code) end
	end
	if needShift then keyUp(Enum.KeyCode.LeftShift) end
end

-- VP sheets: whitespace (space OR newline) only separates beats — same timing
local function parseSheet(text)
	local events = {}
	if type(text) ~= "string" then return events end
	for raw in text:gmatch("%S+") do
		-- pure dash token = explicit rest (rare)
		if raw:match("^[%-–—]+$") then
			table.insert(events, { type = "rest", units = #raw })
		else
			local chars = extractChars(raw)
			if #chars > 0 then
				table.insert(events, { type = "notes", chars = chars })
			end
		end
	end
	return events
end

local function beat()
	local s = math.clamp(tonumber(PianoState.speed) or 50, 1, 100)
	-- 50 → ~0.13s per token; higher speed = shorter beat
	return 0.13 * (50 / s)
end

