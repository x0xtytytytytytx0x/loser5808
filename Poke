local PoolState = {
	enhance = false,
	rainbow = false,
	token = 0,
	clones = {},          -- [original] = clone
	origSize = {},
}

local RED_SKIP = Color3.fromRGB(255, 50, 50)

local function isSkipRed(c)
	if not c then return false end
	return math.abs(c.R * 255 - 255) < 8
		and math.abs(c.G * 255 - 50) < 8
		and math.abs(c.B * 255 - 50) < 8
end

local function getPoolTablesFolder()
	local ga = workspace:FindFirstChild("GameAssets")
	return ga and ga:FindFirstChild("PoolTables")
end

local function getCueBalls()
	local list = {}
	local folder = getPoolTablesFolder()
	if not folder then return list end
	for _, tbl in ipairs(folder:GetChildren()) do
		local balls = tbl:FindFirstChild("Balls")
		local cue = balls and balls:FindFirstChild("CueBall")
		if cue and cue:IsA("BasePart") then
			table.insert(list, cue)
		end
	end
	return list
end

local function farthestPocketDistance(fromPos)
	local best = 0
	local folder = getPoolTablesFolder()
	if not folder then return 40 end
	for _, tbl in ipairs(folder:GetChildren()) do
		local pt = tbl:FindFirstChild("Pool Table") or tbl:FindFirstChild("PoolTable")
		local pockets = pt and pt:FindFirstChild("Pockets")
		if pockets then
			for _, p in ipairs(pockets:GetDescendants()) do
				if p:IsA("BasePart") then
					local d = (p.Position - fromPos).Magnitude
					if d > best then best = d end
				end
			end
		end
	end
	return best > 0 and best or 40
end

local function segmentTouchesCue(seg, cueBalls)
	if not seg:IsA("BasePart") then return false end
	for _, cue in ipairs(cueBalls) do
		local dist = (seg.Position - cue.Position).Magnitude
		local reach = (seg.Size.Magnitude * 0.5) + (cue.Size.Magnitude * 0.5) + 0.35
		if dist <= reach then return true end
		local ok, touching = pcall(function() return seg:GetTouchingParts() end)
		if ok and touching then
			for _, t in ipairs(touching) do
				if t == cue then return true end
			end
		end
	end
	return false
end

-- lengthen part along its longest axis
-- keeps the original BACK end fixed and only extends FORWARD
local function lengthenSegment(seg, targetLen)
	if not seg:IsA("BasePart") then return end

	if not PoolState.origSize[seg] then
		PoolState.origSize[seg] = seg.Size
	end

	local s = PoolState.origSize[seg]

	local ax = "X"
	local len = s.X
	if s.Y >= len then ax, len = "Y", s.Y end
	if s.Z >= len then ax, len = "Z", s.Z end

	local newLen = math.max(len, targetLen)

	-- Always make it Plastic.
	seg.Material = Enum.Material.Plastic

	-- Never shrink the original segment.
	if newLen <= len then
		return
	end

	local added = newLen - len
	local cf = seg.CFrame

	if ax == "X" then
		seg.Size = Vector3.new(newLen, s.Y, s.Z)
		seg.CFrame = cf + cf.RightVector * (added / 2)

	elseif ax == "Y" then
		seg.Size = Vector3.new(s.X, newLen, s.Z)
		seg.CFrame = cf + cf.UpVector * (added / 2)

	else
		seg.Size = Vector3.new(s.X, s.Y, newLen)
		seg.CFrame = cf + cf.LookVector * (added / 2)
	end
end

local function clearClones()
	for orig, clone in pairs(PoolState.clones) do
		if clone and clone.Parent then
			pcall(function() clone:Destroy() end)
		end
		-- restore visibility of original
		if orig and orig.Parent then
			pcall(function()
				if orig:IsA("BasePart") then
					orig.Transparency = 0
					orig.CanCollide = false
				elseif orig:IsA("Beam") then
					orig.Enabled = true
				end
			end)
		end
	end
	PoolState.clones = {}
	PoolState.origSize = {}
end

local function setPartColor(inst, color)
	if not inst then return end
	if inst:IsA("BasePart") then
		if isSkipRed(inst.Color) then return end
		inst.Color = color
	elseif inst:IsA("Beam") then
		if inst.Color and inst.Color.Keypoints then
			local k = inst.Color.Keypoints[1]
			if k and isSkipRed(k.Value) then return end
		end
		inst.Color = ColorSequence.new(color)
	end
end

local function applyRainbowColor(color)
	-- also color the contact points
	local targets = {
		workspace:FindFirstChild("ContactPoint"),
		workspace:FindFirstChild("ContactPointX"),
	}
	for _, t in ipairs(targets) do
		setPartColor(t, color)
		if t then
			for _, d in ipairs(t:GetDescendants()) do
				setPartColor(d, color)
			end
		end
	end

	-- color our clones
	for _, clone in pairs(PoolState.clones) do
		if clone and clone.Parent then
			setPartColor(clone, color)
			for _, d in ipairs(clone:GetDescendants()) do
				setPartColor(d, color)
			end
		end
	end
end

-- Main loop that keeps clones alive & updated
local function startPoolLoop()
	PoolState.token += 1
	local my = PoolState.token

	task.spawn(function()
		while (PoolState.enhance or PoolState.rainbow) and PoolState.token == my do
			local lines = workspace:FindFirstChild("TrajectoryLines")
			local cueBalls = getCueBalls()

			if lines then
				-- collect current real segments
				local live = {}
				for _, seg in ipairs(lines:GetDescendants()) do
					if seg:IsA("BasePart") and (seg.Name == "TrajectorySegment" or seg.Parent == lines) then
						live[seg] = true
					end
				end

				-- remove dead clones
				for orig, clone in pairs(PoolState.clones) do
					if not live[orig] or not orig.Parent then
						if clone and clone.Parent then
							pcall(function() clone:Destroy() end)
						end
						PoolState.clones[orig] = nil
						PoolState.origSize[orig] = nil
					end
				end

				-- create / update clones
				for seg in pairs(live) do
					local clone = PoolState.clones[seg]

					if not clone or not clone.Parent then
						-- make a fresh clone
						clone = seg:Clone()
						clone.Name = "EnhancedTrajectory_" .. tostring(seg)
						clone.Anchored = true
						clone.CanCollide = false
						clone.CanQuery = false
						clone.CanTouch = false
						clone.Parent = workspace   -- or a dedicated folder if you prefer

						-- hide original
						seg.Transparency = 1
						if seg:IsA("BasePart") then
							seg.CanCollide = false
						end

						PoolState.clones[seg] = clone
						PoolState.origSize[clone] = seg.Size   -- store original size on the clone
					end

					-- keep clone matched to original transform
					clone.CFrame = seg.CFrame
					clone.Transparency = 0.5

					-- enhance length (only non-cue segments)
					if PoolState.enhance and #cueBalls > 0 then
						if not segmentTouchesCue(seg, cueBalls) then
							local target = farthestPocketDistance(seg.Position)
							lengthenSegment(clone, target * 0.95)
						else
							-- keep original size for the cue-ball segment
							if PoolState.origSize[clone] then
								clone.Size = PoolState.origSize[clone]
							end
						end
					else
						-- just mirror size when enhance is off
						clone.Size = seg.Size
					end
				end
			end

			task.wait(0.03) -- 30+ FPS is plenty and still light
		end

		-- cleanup when both toggles are off
		if not PoolState.enhance and not PoolState.rainbow then
			clearClones()
		end
	end)
end

