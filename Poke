--// GROUP JOIN WARNING
--// ============================================

local GroupWatchEnabled = false

local GROUP_ID = 2757172

--// Roles that will trigger a notification.
--// Leave this as {} to notify for EVERYONE in the group.
local WARN_ROLES = {
	"Holder",
	"Founder",
	"Community Manager",
	"Developer",
	"Staff",
	"Recreation",
	"Ranker",
	"QA Tester",
	"Noted Member",
	--"Gentlemen/women",
}

local function getGroupRole(player)
	local success, role = pcall(function()
		return player:GetRoleInGroupAsync(GROUP_ID)
	end)

	if not success then
		warn("[Group Watch] Failed to get role for " .. player.Name)
		return nil
	end

	-- Guest means they aren't in the group.
	if role == "Guest" then
		return nil
	end

	return role
end

local function roleIsWanted(role)
	-- Empty list = everyone in the group
	if #WARN_ROLES == 0 then
		return true
	end

	for _, wantedRole in ipairs(WARN_ROLES) do
		if role == wantedRole then
			return true
		end
	end

	return false
end

local function checkGroupPlayer(player, reason)
	task.spawn(function()
		local role = getGroupRole(player)

		if not role then
			return
		end

		if not roleIsWanted(role) then
			return
		end

		local message

		if reason == "joined" then
			message = player.DisplayName
				.. " joined the server!\nRole: "
				.. role
		else
			message = player.DisplayName
				.. " is already in the server!\nRole: "
				.. role
		end

		window:Notify({
			title = "R8//TW0",
			text = message,
			icon = 127357392034684,
			duration = 4,
		})

		print(
			"[Group Watch]",
			player.Name,
			"| Role:",
			role,
			"|",
			reason
		)
	end)
end


