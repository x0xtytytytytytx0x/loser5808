
local UILibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/R8Library/R8Library/refs/heads/main/R8LibraryMain"))()
local window = UILibrary:CreateWindow({UsePremadeScripts = false, skipFakeLoading = true})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer


local function fireChar(id)
	local r = ReplicatedStorage:FindFirstChild("Char")
	if not r then
		notify("Characters", "Char remote missing.")
		return
	end
	pcall(function()
		r:FireServer(id)
	end)
	notify("Characters", "Selected: " .. tostring(id), 2)
end

local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getAllTools()
	local list = {}
	local seen = {}
	local function add(parent)
		if not parent then return end
		for _, t in ipairs(parent:GetChildren()) do
			if t:IsA("Tool") and not seen[t] then
				seen[t] = true
				table.insert(list, t)
			end
		end
	end
	add(LocalPlayer.Character)
	add(LocalPlayer:FindFirstChildOfClass("Backpack"))
	return list
end

-- try common move activate patterns on a tool
local function fireToolMoves(tool)
	if not tool then return end
	pcall(function()
		local act = tool:FindFirstChild("activatetool")
		if act and (act:IsA("RemoteEvent") or act:IsA("RemoteFunction")) then
			if act:IsA("RemoteEvent") then
				act:FireServer(LocalPlayer)
			else
				act:InvokeServer(LocalPlayer)
			end
		end
	end)
	-- any RemoteEvent under the tool that looks like an ability
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("RemoteEvent") then
			local n = string.lower(d.Name)
			if n:find("activate", 1, true)
				or n:find("skill", 1, true)
				or n:find("ability", 1, true)
				or n:find("move", 1, true)
				or n:find("attack", 1, true)
				or n:find("use", 1, true)
				or n == "activatetool"
			then
				pcall(function()
					d:FireServer(LocalPlayer)
				end)
			end
		end
	end
end

