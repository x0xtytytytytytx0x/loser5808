local function labels(list)
	local t = {}
	for _, e in ipairs(list) do table.insert(t, e.label) end
	return t
end

local function idFromLabel(list, label)
	for _, e in ipairs(list) do
		if e.label == label then return e.id end
	end
	return nil
end

