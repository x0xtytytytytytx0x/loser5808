				end)
				task.wait()
			end
		end)
	end,
})

PlayerTab:CreateDivider({ text = "Dash" })

local function fireDash()
	local char = LocalPlayer.Character
	local hrp = getHRP()
	if not char or not hrp then return false end
	local remote = ReplicatedStorage:FindFirstChild("DashRemote")
	if not remote then return false end
	local pos = hrp.Position
	local dir = hrp.CFrame.LookVector
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.05 then
		dir = Vector3.new(0, 0, -1)
	else
		dir = dir.Unit
	end
	return pcall(function()
		remote:FireServer(char, pos, dir)
	end)
end

local spamDashOn = false
PlayerTab:CreateToggle({
	name = "Spam dash effect",
	value = false,
	callback = function(state)
		spamDashOn = state
		if not state then
			notify("Dash", "Spam dash off")
			return
		end
		notify("Dash", "Spam dash on")
		task.spawn(function()
			while spamDashOn do
				fireDash()
				task.wait()
			end
		end)
	end,
})

